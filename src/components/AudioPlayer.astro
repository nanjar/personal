---
import Icon from './Icon.astro';
import { asset } from '../lib/paths';

interface Props {
  title?: string;
  subtitle?: string;
  src?: string;
}

const {
  title = 'AI Maverick',
  subtitle = 'Original score — not on streaming',
  src = 'assets/media/ai-maverick.mp3',
} = Astro.props;

const bars = Array.from({ length: 52 }, (_, index) => {
  const shape = Math.abs(Math.sin(index * 1.37) * Math.cos(index * 0.41));
  return 16 + Math.round(shape * 76);
});
---

<div class="audio-player" data-audio-player>
  <audio preload="none" src={asset(src)}></audio>

  <div class="audio-player__top">
    <button class="audio-player__toggle" type="button" data-audio-toggle aria-label={`Play ${title}`}>
      <span class="audio-player__icon audio-player__icon--play" data-audio-icon="play"><Icon name="play" size={15} /></span>
      <span class="audio-player__icon audio-player__icon--pause" data-audio-icon="pause"><Icon name="pause" size={15} /></span>
    </button>

    <div class="audio-player__info">
      <span class="mono">Now playing / score</span>
      <strong>{title}</strong>
      <small>{subtitle}</small>
    </div>

    <span class="audio-player__time" data-audio-time>0:00 / 0:00</span>
  </div>

  <div class="audio-player__wave" aria-hidden="true">
    {bars.map((height, index) => <span style={`--h:${height}%;--i:${index}`}></span>)}
  </div>

  <input
    class="audio-player__seek"
    type="range"
    min="0"
    max="100"
    value="0"
    step="0.1"
    aria-label={`Seek through ${title}`}
    data-audio-seek
  />
</div>

<style>
  .audio-player {
    padding: 18px 20px 15px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background:
      linear-gradient(135deg, rgba(201, 255, 87, 0.045), transparent 45%),
      rgba(13, 16, 17, 0.75);
    backdrop-filter: blur(10px);
  }

  .audio-player__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .audio-player__toggle {
    display: grid;
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--acid);
    color: var(--ink);
    transition: background-color 0.25s, transform 0.25s;
    place-items: center;
  }

  .audio-player__toggle:hover {
    background: var(--paper);
    transform: scale(1.04);
  }

  .audio-player__icon {
    display: grid;
    place-items: center;
  }

  .audio-player__icon--pause {
    display: none;
  }

  .audio-player.is-playing .audio-player__icon--play {
    display: none;
  }

  .audio-player.is-playing .audio-player__icon--pause {
    display: grid;
  }

  .audio-player__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .audio-player__info .mono {
    color: var(--muted);
    font-size: 0.5rem;
  }

  .audio-player__info strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .audio-player__info small {
    color: var(--muted);
    font-size: 0.65rem;
    line-height: 1.4;
  }

  .audio-player__time {
    flex: 0 0 auto;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.04em;
  }

  .audio-player__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 34px;
    margin: 14px 0 10px;
    overflow: hidden;
  }

  .audio-player__wave span {
    flex: 1;
    height: var(--h);
    min-width: 1px;
    border-radius: 99px;
    background: rgba(242, 239, 232, 0.2);
    transform-origin: center;
    transition: background-color 0.3s;
  }

  .audio-player.is-playing .audio-player__wave span {
    background: var(--acid);
    animation: audio-wave 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.045s);
  }

  .audio-player.is-playing .audio-player__wave span:nth-child(4n) {
    background: var(--paper);
  }

  @keyframes audio-wave {
    from {
      transform: scaleY(0.45);
      opacity: 0.55;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .audio-player__seek {
    display: block;
    width: 100%;
    height: 14px;
    margin: 0;
    padding: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }

  .audio-player__seek::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 99px;
    background: linear-gradient(to right, var(--acid) var(--progress, 0%), rgba(242, 239, 232, 0.16) var(--progress, 0%));
  }

  .audio-player__seek::-moz-range-track {
    height: 2px;
    border-radius: 99px;
    background: rgba(242, 239, 232, 0.16);
  }

  .audio-player__seek::-moz-range-progress {
    height: 2px;
    background: var(--acid);
  }

  .audio-player__seek::-webkit-slider-thumb {
    width: 10px;
    height: 10px;
    margin-top: -4px;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    appearance: none;
  }

  .audio-player__seek::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
  }

  @media (max-width: 520px) {
    .audio-player {
      padding: 15px 16px 12px;
    }
    .audio-player__time {
      display: none;
    }
    .audio-player__wave {
      height: 28px;
    }
  }
</style>

<script>
  const format = (seconds: number) => {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const minutes = Math.floor(seconds / 60);
    return `${minutes}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-audio-player]').forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>('audio');
    const toggle = player.querySelector<HTMLButtonElement>('[data-audio-toggle]');
    const seek = player.querySelector<HTMLInputElement>('[data-audio-seek]');
    const time = player.querySelector<HTMLElement>('[data-audio-time]');
    if (!audio || !toggle || !seek || !time) return;

    let duration = 0;

    const syncTime = () => {
      time.textContent = `${format(audio.currentTime)} / ${format(duration)}`;
      const progress = duration ? (audio.currentTime / duration) * 100 : 0;
      seek.value = String(progress);
      seek.style.setProperty('--progress', `${progress}%`);
    };

    audio.addEventListener('loadedmetadata', () => {
      duration = audio.duration;
      syncTime();
    });

    audio.addEventListener('timeupdate', syncTime);

    audio.addEventListener('play', () => {
      player.classList.add('is-playing');
      toggle.setAttribute('aria-label', `Pause ${player.querySelector('strong')?.textContent ?? 'audio'}`);
    });

    audio.addEventListener('pause', () => {
      player.classList.remove('is-playing');
      toggle.setAttribute('aria-label', `Play ${player.querySelector('strong')?.textContent ?? 'audio'}`);
    });

    audio.addEventListener('ended', () => {
      player.classList.remove('is-playing');
      audio.currentTime = 0;
      syncTime();
    });

    toggle.addEventListener('click', () => {
      if (audio.paused) {
        if (audio.readyState === 0) audio.load();
        void audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });

    seek.addEventListener('input', () => {
      if (!duration) return;
      audio.currentTime = (Number(seek.value) / 100) * duration;
      syncTime();
    });
  });
</script>
