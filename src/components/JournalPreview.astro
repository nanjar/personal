---
import SectionHead from './SectionHead.astro';
import JournalRow from './JournalRow.astro';
import Icon from './Icon.astro';
import { articles } from '../lib/articles';
import { url } from '../lib/paths';

const latest = articles.slice(0, 3);
---

<section class="section journal-preview" id="journal">
  <div class="container">
    <SectionHead index="04 / Journal">
      <Fragment slot="title">Notes from<br /><em>the machine.</em></Fragment>
      <Fragment slot="note">
        Practical experiments in AI music, film, local models, and automation. Written to be useful — and
        honest about what still doesn't work.
        <br /><br />
        <a href={url('/blog/')}>Browse all 8 notes <span aria-hidden="true">↗</span></a>
      </Fragment>
    </SectionHead>

    <div class="journal-list">
      {latest.map((article, index) => <JournalRow article={article} index={index + 1} />)}
    </div>

    <div class="journal-foot" data-reveal>
      <p class="mono">Long-form notes · no growth hacks · occasional mistakes included</p>
      <a class="link-arrow" href={url('/blog/')}>
        Read the journal
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>

<style>
  .journal-preview {
    border-top: 1px solid var(--line);
  }

  .journal-list {
    margin-top: clamp(48px, 6vw, 76px);
  }

  .journal-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-top: 30px;
  }

  .journal-foot p {
    color: var(--muted);
    font-size: 0.53rem;
  }

  @media (max-width: 650px) {
    .journal-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
