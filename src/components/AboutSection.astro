---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { asset, url } from '../lib/paths';
import { imagePlaceholder } from '../lib/images';

const principles = [
  { number: '01', title: 'Taste is the differentiator', text: 'Tools are everywhere. Point of view is not.' },
  { number: '02', title: 'Story before spectacle', text: 'The effect should serve the feeling, not replace it.' },
  { number: '03', title: 'Build the system, too', text: 'The workflow is part of the craft — and often the advantage.' },
];
---

<section class="section about-section" id="practice">
  <div class="container">
    <SectionHead index="01 / Practice">
      <Fragment slot="title">Human direction.<br /><em>Machine speed.</em></Fragment>
      <Fragment slot="note">
        A one-person studio in Bandung, working with a growing stack of generative tools — and a fairly
        stubborn attachment to story.
        <br /><br />
        <a href={url('/about/')}>More about the practice <span aria-hidden="true">↗</span></a>
      </Fragment>
    </SectionHead>

    <div class="about-layout">
      <div class="about-visual" data-reveal>
        <div class="portrait-frame">
          <img
            src={imagePlaceholder}
            data-src={asset('assets/images/nanjar-960.webp')}
            data-srcset={`${asset('assets/images/nanjar-480.webp')} 480w, ${asset('assets/images/nanjar-960.webp')} 960w`}
            sizes="(max-width: 900px) 90vw, 540px"
            alt="Nanjar Budiman in low, cinematic light"
            width="960"
            height="960"
            loading="lazy"
            decoding="async"
          />
          <span class="portrait-frame__grain" aria-hidden="true"></span>
          <span class="portrait-frame__corner portrait-frame__corner--tl" aria-hidden="true"></span>
          <span class="portrait-frame__corner portrait-frame__corner--br" aria-hidden="true"></span>
          <span class="portrait-frame__label mono">Portrait / Bandung, 2026</span>
        </div>

        <div class="studio-card">
          <img
            src={imagePlaceholder}
            data-src={asset('assets/images/studio-400.webp')}
            alt="Nanjar's workstation with monitoring screens"
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
          />
          <span class="studio-card__caption mono">The control room / 6.9175° S</span>
        </div>

        <div class="about-chip">
          <span class="dot-live"></span>
          <span>Human in the loop</span>
        </div>
      </div>

      <div class="about-copy">
        <p class="about-lead" data-reveal>
          I make <em>emotion</em><br />with new tools.
        </p>

        <div class="about-text" data-reveal style="--delay: 90ms">
          <p>
            I am Nanjar Budiman — an AI content creator, musician, and cinematic storyteller. I write
            songs, direct short films, and build the automation that quietly holds the studio together.
          </p>
          <p>
            My work starts with a human idea: a memory, a question, a line that won't leave. Then AI helps
            me move from that idea to something you can hear, watch, and feel. The machine is fast. The
            point of view is mine.
          </p>
        </div>

        <div class="principles" data-reveal style="--delay: 160ms">
          {principles.map((principle) => (
            <div class="principle">
              <span class="principle__number mono">{principle.number}</span>
              <div>
                <h3>{principle.title}</h3>
                <p>{principle.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="about-stats" data-reveal style="--delay: 220ms">
          <div><strong>12</strong><span>films &amp; music videos</span></div>
          <div><strong>06</strong><span>released tracks</span></div>
          <div><strong>08</strong><span>field notes</span></div>
        </div>

        <a class="link-arrow about-link" href={url('/about/')}>
          The longer story
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    border-top: 1px solid var(--line);
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(50px, 9vw, 150px);
    align-items: center;
    margin-top: clamp(48px, 7vw, 96px);
  }

  .about-visual {
    position: relative;
    width: min(100%, 530px);
    margin-left: auto;
    padding-right: 34px;
    padding-bottom: 50px;
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #0d1011;
  }

  .portrait-frame::before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, transparent 55%, rgba(4, 6, 6, 0.55)),
      radial-gradient(circle at 80% 10%, rgba(201, 255, 87, 0.13), transparent 38%);
    content: '';
    pointer-events: none;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    filter: contrast(1.04) saturate(0.8);
    transition: transform 1.2s var(--ease), filter 0.5s;
  }

  .portrait-frame:hover img {
    filter: contrast(1.02) saturate(0.95);
    transform: scale(1.025);
  }

  .portrait-frame__grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.16;
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.32) 3px
    );
    pointer-events: none;
  }

  .portrait-frame__corner {
    position: absolute;
    z-index: 3;
    width: 26px;
    height: 26px;
    border-color: var(--acid);
    border-style: solid;
    opacity: 0.8;
  }
  .portrait-frame__corner--tl {
    top: 12px;
    left: 12px;
    border-width: 1px 0 0 1px;
  }
  .portrait-frame__corner--br {
    right: 12px;
    bottom: 12px;
    border-width: 0 1px 1px 0;
  }

  .portrait-frame__label {
    position: absolute;
    right: 16px;
    bottom: 14px;
    z-index: 3;
    color: rgba(242, 239, 232, 0.65);
    font-size: 0.51rem;
  }

  .studio-card {
    position: absolute;
    bottom: 0;
    left: -34px;
    width: 190px;
    padding: 7px;
    border: 1px solid var(--line);
    background: var(--ink);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    transform: rotate(-3deg);
  }

  .studio-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.82);
  }

  .studio-card__caption {
    display: block;
    padding-top: 7px;
    color: var(--muted);
    font-size: 0.45rem;
    letter-spacing: 0.08em;
  }

  .about-chip {
    position: absolute;
    top: 22px;
    right: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(8, 10, 11, 0.72);
    color: var(--paper-dim);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .about-lead {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.8vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .about-lead em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .about-text {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(28px, 4vw, 46px);
  }

  .about-text p {
    color: var(--muted-strong);
    font-size: 0.86rem;
    line-height: 1.72;
  }

  .principles {
    margin-top: clamp(32px, 4.5vw, 52px);
    border-top: 1px solid var(--line);
  }

  .principle {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    padding-block: 13px;
    border-bottom: 1px solid var(--line-soft);
  }

  .principle__number {
    padding-top: 3px;
    color: var(--acid);
    font-size: 0.52rem;
  }

  .principle h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 540;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .principle p {
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .about-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .about-stats strong {
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 450;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .about-stats span {
    max-width: 14ch;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .about-link {
    margin-top: 28px;
  }

  @media (max-width: 980px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .about-visual {
      width: min(100%, 560px);
      margin-inline: auto;
      padding-right: 26px;
    }
    .about-copy {
      max-width: 680px;
    }
  }

  @media (max-width: 560px) {
    .about-visual {
      padding-right: 18px;
      padding-bottom: 36px;
    }
    .studio-card {
      left: -10px;
      width: 132px;
    }
    .about-text {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .about-chip {
      top: 12px;
    }
    .about-stats {
      gap: 10px;
    }
    .about-stats strong {
      font-size: 1.75rem;
    }
  }
</style>
