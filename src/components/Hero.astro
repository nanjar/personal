---
import Icon from './Icon.astro';
import { asset, url } from '../lib/paths';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="hero-kicker" data-reveal>
        <span class="dot-live"></span>
        <span>Independent AI creative — Bandung, Indonesia</span>
      </div>

      <h1 class="hero-title" id="hero-title" aria-label="AI is the instrument. Story is the soul.">
        <span>AI is the</span>
        <span><em>instrument.</em></span>
        <span>Story is</span>
        <span><em>the soul.</em></span>
      </h1>

      <p class="hero-lead" data-reveal style="--delay: 160ms">
        Nanjar Budiman creates <strong>AI music</strong>, <strong>cinematic video</strong>, and
        intelligent workflows — using generative tools as a means, never the message.
      </p>

      <div class="hero-actions" data-reveal style="--delay: 230ms">
        <a class="btn btn--acid" href={url('/work/')}>
          Explore the work
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="hero-text-link" href={url('/blog/')}>
          Read the journal
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <a class="hero-signature" href={url('/about/')} data-reveal style="--delay: 300ms">
        <img
          src={asset('assets/images/nanjar-480.webp')}
          srcset={`${asset('assets/images/nanjar-480.webp')} 480w, ${asset('assets/images/nanjar-960.webp')} 960w`}
          sizes="48px"
          alt="Portrait of Nanjar Budiman"
          width="48"
          height="48"
        />
        <span>
          <strong>Nanjar Budiman</strong>
          <small>AI creative / musician / director</small>
        </span>
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>

    <div class="hero-visual" data-hero-visual>
      <div class="scene-halo" aria-hidden="true"></div>
      <div class="orb-fallback" aria-hidden="true"><span></span></div>
      <div id="hero-canvas" data-hero-canvas aria-hidden="true"></div>

      <span class="orbit-tag orbit-tag--music"><i></i>AI music</span>
      <span class="orbit-tag orbit-tag--film"><i></i>Cinematic</span>
      <span class="orbit-tag orbit-tag--automation"><i></i>Automation</span>

      <div class="scene-caption">
        <span>Neural bloom / real-time WebGL</span>
        <span class="scene-caption__line"></span>
        <span>Move cursor to orbit</span>
      </div>
    </div>
  </div>

  <div class="container hero-foot">
    <a class="hero-scroll" href="#practice">
      <span class="hero-scroll__ring"><Icon name="arrow-down" size={14} /></span>
      <span>Scroll to explore</span>
    </a>
    <span class="hero-coords mono">6.9175° S / 107.6191° E</span>
    <span class="hero-status"><span class="dot-live"></span> Open to collaborations</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: clamp(116px, 14vh, 152px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 72% 42%, rgba(201, 255, 87, 0.075), transparent 27%),
      radial-gradient(ellipse at 82% 66%, rgba(255, 107, 61, 0.055), transparent 24%),
      radial-gradient(ellipse at 18% 82%, rgba(134, 183, 255, 0.045), transparent 28%);
  }

  .hero-bg::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(242, 239, 232, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 239, 232, 0.032) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(ellipse at 60% 40%, black, transparent 68%);
    content: '';
    opacity: 0.55;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: clamp(8px, 2vw, 36px);
    align-items: center;
    flex: 1;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(24px, 4vh, 48px);
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(22px, 3.4vh, 38px);
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 11ch;
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 7.2vw, 7.8rem);
    font-weight: 500;
    letter-spacing: -0.072em;
    line-height: 0.84;
  }

  .hero-title > span {
    display: block;
    white-space: nowrap;
  }

  .hero-title > span:nth-child(2),
  .hero-title > span:nth-child(4) {
    padding-left: clamp(18px, 3.8vw, 68px);
  }

  .hero-title em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .hero-title > span:last-child em {
    color: var(--paper);
  }

  .hero-lead {
    max-width: 43ch;
    margin-top: clamp(22px, 3.4vh, 36px);
    color: var(--muted-strong);
    font-size: clamp(0.94rem, 1.08vw, 1.08rem);
    line-height: 1.7;
  }

  .hero-lead strong {
    color: var(--paper);
    font-weight: 560;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: clamp(24px, 3.6vh, 38px);
  }

  .hero-text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--line);
    color: var(--paper-dim);
    font-size: 0.78rem;
    font-weight: 560;
    transition: border-color 0.25s, color 0.25s;
  }

  .hero-text-link:hover {
    border-color: var(--acid);
    color: var(--acid);
  }

  .hero-signature {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    width: fit-content;
    margin-top: clamp(26px, 4.2vh, 48px);
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
    transition: color 0.25s;
  }

  .hero-signature img {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(242, 239, 232, 0.24);
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(0.3) contrast(1.05);
  }

  .hero-signature span {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hero-signature strong {
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .hero-signature small {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-signature > :global(svg) {
    margin-left: 5px;
    color: var(--muted);
  }

  .hero-signature:hover {
    color: var(--acid);
  }

  .hero-signature:hover > :global(svg) {
    color: var(--acid);
  }

  .hero-visual {
    position: relative;
    align-self: stretch;
    min-height: 560px;
    height: calc(100svh - 210px);
    max-height: 890px;
  }

  #hero-canvas,
  #hero-canvas :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  #hero-canvas {
    -webkit-mask-image: radial-gradient(ellipse 68% 70% at 50% 50%, #000 48%, transparent 88%);
    mask-image: radial-gradient(ellipse 68% 70% at 50% 50%, #000 48%, transparent 88%);
  }

  .scene-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--acid);
    filter: blur(100px);
    opacity: 0.09;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .orb-fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.8), transparent 6%),
      radial-gradient(circle at 35% 30%, #d7ff9d, #c9ff57 20%, #ff6b3d 48%, #111a16 72%, #070a09);
    box-shadow: 0 0 120px rgba(201, 255, 87, 0.2);
    opacity: 1;
    transform: translate(-50%, -50%);
    transition: opacity 0.9s var(--ease);
    animation: fallback-breathe 8s ease-in-out infinite;
    pointer-events: none;
  }

  .orb-fallback::before {
    position: absolute;
    inset: -22%;
    border: 1px dashed rgba(242, 239, 232, 0.18);
    border-radius: 50%;
    content: '';
    animation: fallback-rotate 34s linear infinite;
  }

  .orb-fallback::after {
    position: absolute;
    inset: -8%;
    border: 1px solid rgba(201, 255, 87, 0.2);
    border-radius: 50%;
    content: '';
    animation: fallback-rotate 24s linear infinite reverse;
  }

  .hero-visual.is-ready .orb-fallback {
    opacity: 0;
  }

  @keyframes fallback-breathe {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.035);
    }
  }

  @keyframes fallback-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-visual.is-fallback #hero-canvas,
  .hero-visual.is-fallback .orbit-tag,
  .hero-visual.is-fallback .scene-caption {
    display: none;
  }

  .orbit-tag {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 9px;
    border: 1px solid rgba(242, 239, 232, 0.1);
    border-radius: 999px;
    background: rgba(8, 10, 11, 0.5);
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(7px);
    pointer-events: none;
  }

  .orbit-tag i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--acid);
    box-shadow: 0 0 12px rgba(201, 255, 87, 0.8);
  }

  .orbit-tag::after {
    width: 34px;
    height: 1px;
    background: linear-gradient(90deg, var(--line), transparent);
    content: '';
  }

  .orbit-tag--music {
    top: 16%;
    right: 2%;
  }

  .orbit-tag--film {
    top: 48%;
    left: -1%;
    flex-direction: row-reverse;
  }

  .orbit-tag--film::after {
    background: linear-gradient(270deg, var(--line), transparent);
  }

  .orbit-tag--automation {
    right: 9%;
    bottom: 17%;
  }

  .scene-caption {
    position: absolute;
    bottom: 1%;
    left: 4%;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
    pointer-events: none;
  }

  .scene-caption__line {
    width: 28px;
    height: 1px;
    background: var(--line);
  }

  .hero-foot {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    padding-block: 18px 26px;
    border-top: 1px solid var(--line-soft);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    color: var(--paper-dim);
    transition: color 0.25s;
  }

  .hero-scroll:hover {
    color: var(--acid);
  }

  .hero-scroll__ring {
    display: grid;
    width: 29px;
    height: 29px;
    border: 1px solid var(--line);
    border-radius: 50%;
    place-items: center;
  }

  .hero-coords {
    opacity: 0.65;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 8px;
    color: var(--muted-strong);
  }

  @media (max-width: 1080px) {
    .hero-title {
      font-size: clamp(3.35rem, 7.6vw, 6.6rem);
    }
    .hero-visual {
      min-height: 480px;
    }
    .orbit-tag--film {
      left: 0;
    }
  }

  @media (max-width: 840px) {
    .hero {
      min-height: auto;
      padding-top: 120px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-copy {
      padding-bottom: 0;
    }
    .hero-title {
      max-width: 100%;
      font-size: clamp(3.35rem, 12.2vw, 6rem);
    }
    .hero-visual {
      align-self: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 1 / 0.92;
      margin-top: 8px;
    }
    .scene-caption {
      left: 2%;
    }
    .hero-foot {
      grid-template-columns: 1fr auto;
      margin-top: 8px;
    }
    .hero-coords {
      display: none;
    }
    .hero-status {
      justify-self: end;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 106px;
    }
    .hero-kicker {
      font-size: 0.55rem;
      letter-spacing: 0.1em;
    }
    .hero-title {
      font-size: clamp(3rem, 12.8vw, 4.4rem);
      line-height: 0.87;
    }
    .hero-title > span:nth-child(2),
    .hero-title > span:nth-child(4) {
      padding-left: 16px;
    }
    .hero-lead {
      font-size: 0.92rem;
    }
    .hero-actions {
      gap: 20px;
      flex-wrap: wrap;
    }
    .hero-actions .btn {
      min-height: 46px;
      padding: 11px 16px 11px 19px;
      font-size: 0.76rem;
    }
    .hero-signature {
      margin-top: 28px;
    }
    .hero-status {
      display: none;
    }
    .hero-foot {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      aspect-ratio: 1 / 1.02;
      margin-inline: -8vw;
      width: calc(100% + 16vw);
    }
    .orbit-tag {
      font-size: 0.5rem;
    }
    .orbit-tag--music {
      right: 8%;
    }
    .orbit-tag--film {
      left: 7%;
    }
    .orbit-tag--automation {
      right: 12%;
      bottom: 14%;
    }
    .scene-caption {
      display: none;
    }
  }
</style>

<script>
  const visual = document.querySelector<HTMLElement>('[data-hero-visual]');

  if (visual) {
    const start = async () => {
      try {
        const { initHeroScene } = await import('../scripts/hero-scene');
        initHeroScene(visual);
      } catch {
        visual.classList.add('is-fallback');
      }
    };

    // Give the headline and fonts time to paint before the WebGL work starts.
    // The animated CSS bloom holds the composition until then.
    window.setTimeout(() => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => void start(), { timeout: 900 });
      } else {
        void start();
      }
    }, 1500);
  }
</script>
