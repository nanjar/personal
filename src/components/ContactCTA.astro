---
import Icon from './Icon.astro';
import { socials } from '../data/site';
import { url } from '../lib/paths';
---

<section class="contact-cta" id="contact">
  <div class="contact-cta__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="contact-cta__top">
      <span class="eyebrow">06 / Contact</span>
      <span class="contact-cta__time mono"><span class="dot-live"></span> Bandung — <span data-bandung-time>--:--</span></span>
    </div>

    <h2 data-reveal>
      Have a story<br />
      worth <em>making?</em>
    </h2>

    <div class="contact-cta__bottom">
      <p data-reveal>
        A song, a film, a strange experiment, a workflow that should exist but doesn't yet. If it needs
        taste and a generative toolkit, I'd like to hear about it.
      </p>
      <div class="contact-cta__actions" data-reveal style="--delay: 100ms">
        <a class="btn btn--acid" href={url('/contact/')}>
          Start a conversation
          <Icon name="arrow-up-right" size={16} />
        </a>
        <div class="contact-cta__socials">
          {socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
              <Icon name={social.icon} size={17} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container contact-cta__rule">
    <span class="mono">Available for collaborations / worldwide</span>
    <span class="mono">Bandung / GMT+7</span>
  </div>
</section>

<style>
  .contact-cta {
    position: relative;
    padding: clamp(72px, 10vw, 140px) 0 0;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .contact-cta__glow {
    position: absolute;
    top: -45%;
    right: -10%;
    width: 60vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(201, 255, 87, 0.13), transparent 54%),
      conic-gradient(from 120deg, transparent, rgba(255, 107, 61, 0.06), transparent 40%);
    filter: blur(20px);
    pointer-events: none;
  }

  .contact-cta__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line-soft);
  }

  .contact-cta__time {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.58rem;
  }

  .contact-cta h2 {
    max-width: 13ch;
    margin: clamp(42px, 6vw, 82px) 0 clamp(46px, 7vw, 92px);
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 10.5vw, 12rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .contact-cta h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .contact-cta__bottom {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(34px, 8vw, 120px);
    align-items: end;
    padding-bottom: clamp(58px, 8vw, 110px);
  }

  .contact-cta__bottom p {
    max-width: 44ch;
    color: var(--muted-strong);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.7;
  }

  .contact-cta__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 30px;
  }

  .contact-cta__socials {
    display: flex;
    gap: 7px;
  }

  .contact-cta__socials a {
    display: grid;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted-strong);
    transition: border-color 0.25s, color 0.25s, background-color 0.25s;
    place-items: center;
  }

  .contact-cta__socials a:hover {
    border-color: var(--acid);
    background: var(--acid);
    color: var(--ink);
  }

  .contact-cta__rule {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 15px;
    border-top: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: 0.51rem;
  }

  @media (max-width: 800px) {
    .contact-cta__bottom {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .contact-cta__actions {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
    .contact-cta h2 {
      max-width: 11ch;
    }
  }

  @media (max-width: 560px) {
    .contact-cta__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
    .contact-cta__actions {
      gap: 18px;
    }
    .contact-cta__rule {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>

<script>
  const clock = document.querySelector<HTMLElement>('[data-bandung-time]');
  if (clock) {
    const update = () => {
      clock.textContent = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Asia/Jakarta',
      }).format(new Date());
    };
    update();
    window.setInterval(update, 30_000);
  }
</script>
