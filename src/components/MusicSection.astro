---
import SectionHead from './SectionHead.astro';
import AlbumArt from './AlbumArt.astro';
import AudioPlayer from './AudioPlayer.astro';
import Icon from './Icon.astro';
import { tracks } from '../data/site';
import { url } from '../lib/paths';

const featured = tracks[0];
---

<section class="section music-section" id="music">
  <div class="container">
    <SectionHead index="03 / Sound">
      <Fragment slot="title">Sound with a <em>pulse.</em></Fragment>
      <Fragment slot="note">
        Songs about distance, faith, memory, and the small dramas of being human — written and produced
        with AI as a collaborator.
        <br /><br />
        <a href={url('/music/')}>All releases <span aria-hidden="true">↗</span></a>
      </Fragment>
    </SectionHead>

    <div class="music-layout">
      <div class="music-feature" data-reveal>
        <div class="cover-stack">
          <div class="cover-vinyl" aria-hidden="true"></div>
          <AlbumArt track={featured} index={0} />
          <span class="cover-label mono">Latest release / 2026</span>
        </div>

        <div class="feature-caption">
          <div>
            <span class="mono">Featured single</span>
            <h3>{featured.title}</h3>
          </div>
          <a
            class="btn btn--outline btn--small"
            href={`https://open.spotify.com/album/${featured.spotifyId}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="spotify" size={16} />
            Spotify
          </a>
        </div>
      </div>

      <div class="music-list" data-reveal style="--delay: 120ms">
        <div class="music-list__head mono">
          <span>Selected discography</span>
          <span>06 releases</span>
        </div>

        {tracks.map((track, index) => (
          <a
            class="track-row"
            href={`https://open.spotify.com/album/${track.spotifyId}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="track-row__num">{String(index + 1).padStart(2, '0')}</span>
            <span class="track-row__art"><AlbumArt track={track} index={index} mini /></span>
            <span class="track-row__name">{track.title}<small>Nanjar Budiman</small></span>
            <span class="track-row__action"><Icon name="spotify" size={17} /><Icon name="arrow-up-right" size={13} /></span>
          </a>
        ))}

        <div class="score-card">
          <div class="score-card__head">
            <span class="mono">Off-platform / original score</span>
            <span class="tag">Exclusive</span>
          </div>
          <AudioPlayer />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .music-section {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse at 15% 55%, rgba(255, 107, 61, 0.045), transparent 34%),
      radial-gradient(ellipse at 82% 42%, rgba(201, 255, 87, 0.035), transparent 28%);
  }

  .music-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(50px, 8vw, 130px);
    align-items: start;
    margin-top: clamp(48px, 7vw, 92px);
  }

  .music-feature {
    position: sticky;
    top: 110px;
    max-width: 520px;
  }

  .cover-stack {
    position: relative;
    isolation: isolate;
  }

  .cover-vinyl {
    position: absolute;
    top: 4%;
    right: -8%;
    z-index: -1;
    width: 94%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle at center, transparent 0 4px, rgba(242, 239, 232, 0.06) 5px 6px),
      conic-gradient(from 20deg, #111 0 20%, #272727 20% 25%, #0c0c0c 25% 46%, #2b2b2b 46% 51%, #0e0e0e 51% 72%, #242424 72% 76%, #0a0a0a 76%);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
    transition: transform 0.8s var(--ease);
  }

  .cover-vinyl::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--acid);
    box-shadow: 0 0 0 5px #0b0d0d;
    content: '';
    transform: translate(-50%, -50%);
  }

  .cover-stack:hover .cover-vinyl {
    transform: translateX(6%) rotate(12deg);
  }

  .cover-label {
    position: absolute;
    right: 0;
    bottom: -24px;
    color: var(--muted);
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    writing-mode: vertical-rl;
  }

  .feature-caption {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 36px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .feature-caption .mono {
    color: var(--acid);
    font-size: 0.55rem;
  }

  .feature-caption h3 {
    max-width: 15ch;
    margin-top: 7px;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }

  .music-list {
    padding-top: 2px;
  }

  .music-list__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.55rem;
  }

  .track-row {
    display: grid;
    grid-template-columns: 32px 48px minmax(0, 1fr) 62px;
    gap: 14px;
    align-items: center;
    padding-block: 12px;
    border-bottom: 1px solid var(--line-soft);
    transition: border-color 0.3s, padding-left 0.3s;
  }

  .track-row__num {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  .track-row__art {
    display: block;
    width: 48px;
    height: 48px;
  }

  .track-row__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 520;
    letter-spacing: -0.028em;
    line-height: 1.2;
    transition: color 0.25s;
  }

  .track-row__name small {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .track-row__action {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    color: var(--muted);
    transition: color 0.25s;
  }

  .track-row:hover {
    border-color: var(--line);
    padding-left: 6px;
  }

  .track-row:hover .track-row__name {
    color: var(--acid);
  }

  .track-row:hover .track-row__action {
    color: var(--acid);
  }

  .score-card {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .score-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 11px;
    color: var(--muted);
    font-size: 0.55rem;
  }

  @media (max-width: 900px) {
    .music-layout {
      grid-template-columns: 1fr;
      gap: 64px;
    }
    .music-feature {
      position: static;
      max-width: min(520px, 88%);
      margin-inline: auto;
    }
    .cover-label {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .music-feature {
      max-width: 100%;
    }
    .track-row {
      grid-template-columns: 22px 42px minmax(0, 1fr) 44px;
      gap: 10px;
    }
    .track-row__art {
      width: 42px;
      height: 42px;
    }
    .track-row__name {
      font-size: 0.94rem;
    }
    .track-row__action :global(svg:last-child) {
      display: none;
    }
  }
</style>
