---
import type { Track } from '../data/site';
import { asset } from '../lib/paths';
import { imagePlaceholder } from '../lib/images';

interface Props {
  track: Track;
  index: number;
  mini?: boolean;
  class?: string;
}

const { track, index, mini = false, class: className = '' } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<div
  class:list={['album-art', { 'album-art--mini': mini }, className]}
  style={`--hue:${track.hue};--accent:${track.accent}`}
  aria-hidden={mini ? 'true' : undefined}
>
  {track.cover === 'biarkan' ? (
    <div class="album-art__media">
      <img
        src={mini ? asset('assets/images/biarkan-aku-pulang-160.webp') : imagePlaceholder}
        data-src={mini ? undefined : asset('assets/images/biarkan-aku-pulang-640.webp')}
        data-srcset={mini ? undefined : `${asset('assets/images/biarkan-aku-pulang-640.webp')} 640w, ${asset('assets/images/biarkan-aku-pulang-1280.webp')} 1280w`}
        sizes={mini ? '48px' : '(max-width: 900px) 90vw, 520px'}
        alt={mini ? '' : 'Album artwork for Biarkan Aku Pulang Lebih Dulu'}
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      />
      <span class="album-art__scrim"></span>
      {!mini && <span class="album-art__tag mono">Single / 2026</span>}
      {!mini && <span class="album-art__mark">N</span>}
    </div>
  ) : (
    <div class="album-art__media">
      <span class="album-art__gradient"></span>
      <span class="album-art__orb"></span>
      <span class="album-art__grid"></span>
      {!mini && <span class="album-art__tag mono">Nanjar / {number}</span>}
      {!mini && <span class="album-art__title">{track.title}</span>}
      {!mini && <span class="album-art__mark">N</span>}
    </div>
  )}
</div>

<style>
  .album-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: hsl(var(--hue) 26% 8%);
    overflow: hidden;
    container-type: inline-size;
  }

  .album-art__media {
    position: absolute;
    inset: 0;
  }

  .album-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .album-art__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.24), transparent 32%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.48), transparent 35%);
  }

  .album-art__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 70% 22%, hsl(var(--hue) 75% 56% / 0.52), transparent 34%),
      radial-gradient(circle at 25% 78%, hsl(var(--hue) 50% 24% / 0.8), transparent 44%),
      linear-gradient(145deg, hsl(var(--hue) 42% 12%), hsl(var(--hue) 38% 4%) 70%);
  }

  .album-art__orb {
    position: absolute;
    top: 39%;
    left: 68%;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 33% 28%, #fff, transparent 5%),
      radial-gradient(circle at 38% 30%, var(--accent), transparent 24%),
      radial-gradient(circle at 62% 72%, hsl(var(--hue) 60% 20%), transparent 58%),
      linear-gradient(145deg, hsl(var(--hue) 78% 58%), hsl(var(--hue) 40% 16%));
    box-shadow: 0 0 48px hsl(var(--hue) 70% 50% / 0.22);
    transform: translate(-50%, -50%);
    filter: saturate(0.95);
  }

  .album-art__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 18cqw 18cqw;
    mask-image: linear-gradient(180deg, transparent, black);
    opacity: 0.5;
  }

  .album-art__tag {
    position: absolute;
    top: 5.4%;
    left: 6%;
    z-index: 2;
    color: rgba(242, 239, 232, 0.7);
    font-size: 2.1cqw;
    letter-spacing: 0.13em;
  }

  .album-art__title {
    position: absolute;
    right: 6%;
    bottom: 8%;
    left: 6%;
    z-index: 2;
    max-width: 90%;
    font-family: var(--font-display);
    font-size: 7.1cqw;
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .album-art__mark {
    position: absolute;
    right: 6%;
    bottom: 5%;
    z-index: 3;
    color: rgba(242, 239, 232, 0.32);
    font-family: var(--font-serif);
    font-size: 10cqw;
    font-style: italic;
    line-height: 1;
  }

  .album-art--mini {
    border-radius: 3px;
    border-color: var(--line-soft);
  }
</style>
