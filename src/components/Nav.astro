---
import Icon from './Icon.astro';
import { nav, site, socials } from '../data/site';
import { currentPath, url } from '../lib/paths';

const path = currentPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <a class="brand" href={url('/')} aria-label="Nanjar Budiman — home">
      <span class="brand-mark" aria-hidden="true"><span></span></span>
      <span class="brand-word">NANJAR <i>BUDIMAN</i></span>
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      {nav.map((item) => (
        <a
          href={url(item.href)}
          class:list={['nav-link', { 'is-active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <span class="availability"><span class="dot-live"></span> Open to collaborations</span>
      <a class="btn btn--small btn--acid nav-cta" href={site.emailHref}>
        Let's talk
        <Icon name="arrow-up-right" size={15} />
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-nav-toggle>
        <span class="sr-only">Open menu</span>
        <span class="nav-toggle__icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__inner container">
    <div class="mobile-menu__label mono">Index / 2026</div>
    <nav class="mobile-menu__links" aria-label="Mobile navigation">
      {[{ label: 'Home', href: '/' }, ...nav, { label: 'Contact', href: '/contact/' }].map((item, index) => (
        <a href={url(item.href)} class:list={{ 'is-active': isActive(item.href) }} style={`--i:${index}`}>
          <span>{item.label}</span>
          <small>0{index + 1}</small>
        </a>
      ))}
    </nav>
    <div class="mobile-menu__foot">
      <div class="mobile-menu__socials">
        {socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
            <Icon name={social.icon} size={18} />
          </a>
        ))}
      </div>
      <a class="mobile-menu__email" href={site.emailHref}>{site.email}</a>
      <span class="mono">Bandung, ID — {new Date().getFullYear()}</span>
    </div>
  </div>
</div>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 300;
    width: 100%;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      backdrop-filter 0.4s var(--ease);
  }

  .site-nav.is-scrolled,
  .site-nav.menu-open {
    border-color: var(--line-soft);
    background: rgba(8, 10, 11, 0.76);
    backdrop-filter: blur(18px) saturate(120%);
  }

  .nav-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 82px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex: 0 0 auto;
  }

  .brand-mark {
    position: relative;
    display: block;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    background: conic-gradient(from 210deg, #f2efe8, #c9ff57, #ff6b3d, #86b7ff, #f2efe8);
    box-shadow: 0 0 22px rgba(201, 255, 87, 0.14);
  }

  .brand-mark::before {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--ink);
    content: '';
  }

  .brand-mark span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--acid);
    transform: translate(-50%, -50%);
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .brand-word i {
    color: var(--muted);
    font-style: normal;
    font-weight: 450;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: rgba(13, 16, 17, 0.42);
    backdrop-filter: blur(12px);
  }

  .nav-link {
    position: relative;
    padding: 8px 15px;
    border-radius: 999px;
    color: var(--muted-strong);
    font-size: 0.74rem;
    font-weight: 560;
    line-height: 1;
    transition: color 0.25s, background-color 0.25s;
  }

  .nav-link:hover {
    color: var(--paper);
  }

  .nav-link.is-active {
    background: var(--paper);
    color: var(--ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-cta {
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
  }

  .nav-toggle__icon {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: 16px;
    height: 10px;
    transform: translate(-50%, -50%);
  }

  .nav-toggle__icon i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--paper);
    transition: transform 0.3s var(--ease), top 0.3s var(--ease);
  }

  .nav-toggle__icon i:first-child {
    top: 1px;
  }
  .nav-toggle__icon i:last-child {
    top: 8px;
  }

  .menu-open .nav-toggle__icon i:first-child {
    top: 5px;
    transform: rotate(45deg);
  }
  .menu-open .nav-toggle__icon i:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 82px 0 0;
    z-index: 250;
    display: grid;
    background: var(--ink);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), visibility 0.4s;
    overflow-y: auto;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-block: 28px 32px;
  }

  .mobile-menu__label {
    color: var(--muted);
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    margin-block: 32px auto;
    border-top: 1px solid var(--line-soft);
  }

  .mobile-menu__links a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 11vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.95;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    transition-delay: calc(var(--i) * 45ms + 80ms);
  }

  .mobile-menu__links a small {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .mobile-menu__links a.is-active {
    color: var(--acid);
  }

  .mobile-menu.is-open .mobile-menu__links a {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding-top: 22px;
    border-top: 1px solid var(--line-soft);
    color: var(--muted);
  }

  .mobile-menu__email {
    order: 2;
    width: 100%;
    color: var(--paper-dim);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
  }

  .mobile-menu__email:hover {
    color: var(--acid);
  }

  .mobile-menu__socials {
    display: flex;
    gap: 8px;
  }

  .mobile-menu__socials a {
    display: grid;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    place-items: center;
  }

  .mobile-menu__socials a:hover {
    border-color: var(--acid);
    color: var(--acid);
  }

  @media (max-width: 1080px) {
    .availability {
      display: none;
    }
  }

  @media (max-width: 840px) {
    .nav-inner {
      height: 70px;
    }
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
    .mobile-menu {
      inset: 70px 0 0;
    }
    :global(body.menu-open) {
      overflow: hidden;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const setMenu = (open: boolean) => {
    if (!header || !toggle || !menu) return;
    header.classList.toggle('menu-open', open);
    menu.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden', String(!open));
    const label = toggle.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
  };

  toggle?.addEventListener('click', () => {
    setMenu(!header?.classList.contains('menu-open'));
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
