---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { socials } from '../data/site';

const brief = [
  'What you want to make — song, film, visual, or system',
  'Where it will live and who it is for',
  'A deadline, if there is one',
  'Two or three references you love',
];

const faqs = [
  {
    question: 'Can you make a song for my brand or film?',
    answer:
      'Yes. I write and produce original AI-assisted songs, from a simple concept to a release-ready master. We will agree on usage and credits before starting.',
  },
  {
    question: 'Do you work with existing footage or a finished script?',
    answer:
      'Often. I can build a visual treatment around material you already have, or start from a premise and develop the storyboard and look with you.',
  },
  {
    question: 'Can I publish AI-assisted work commercially?',
    answer:
      'That depends on the tools, models, and platform policies involved. I will be transparent about the workflow so you can make an informed call before publishing.',
  },
  {
    question: 'How much does a project cost?',
    answer:
      'Scope decides. A single track, a short film, and a production system are different kinds of work. Send a short brief and I will reply with a clear range.',
  },
];
---

<BaseLayout
  title="Contact — Nanjar Budiman"
  description="Start a project with Nanjar Budiman — AI music, cinematic video, and creative automation from Bandung, Indonesia."
>
  <header class="page-hero contact-hero">
    <div class="container">
      <div class="page-hero__top">
        <span class="eyebrow">Contact / Available for collaborations</span>
        <span class="contact-clock mono"><span class="dot-live"></span> Bandung — <span data-contact-clock>--:--</span></span>
      </div>

      <h1 aria-label="Tell me what you are making.">Tell me<br />what you're<br /><em>making.</em></h1>

      <div class="page-hero__bottom">
        <p class="page-hero__intro" data-reveal style="--delay: 80ms">
          A song, a film, a strange experiment, a workflow that should exist but doesn't yet. If it needs
          taste and a generative toolkit, I'd like to hear about it.
        </p>
        <p class="page-hero__aside" data-reveal style="--delay: 140ms">
          Based in Bandung<br />
          Working worldwide<br />
          GMT+7
        </p>
      </div>
    </div>
  </header>

  <section class="contact-main">
    <div class="container contact-main__grid">
      <div class="contact-primary" data-reveal>
        <span class="eyebrow">Fastest route</span>
        <h2>Send a DM<br /><em>on Instagram.</em></h2>
        <p>
          Tell me what you are making, who it is for, and when it needs to exist. Links and references
          are welcome. I read everything myself.
        </p>
        <a
          class="btn btn--acid contact-primary__button"
          href="https://ig.me/m/nanjarbudiman"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="instagram" size={17} />
          Open Instagram DM
          <Icon name="arrow-up-right" size={14} />
        </a>
        <div class="contact-primary__status">
          <span class="dot-live"></span>
          <span class="mono">Open to collaborations / 2026</span>
        </div>
      </div>

      <div class="contact-channels" data-reveal style="--delay: 100ms">
        <div class="contact-channels__head">
          <span class="mono">Elsewhere</span>
          <span class="mono">Follow the process</span>
        </div>
        {socials.map((social) => (
          <a
            class="channel"
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${social.label} — ${social.handle}`}
          >
            <span class="channel__icon"><Icon name={social.icon} size={18} /></span>
            <span class="channel__body">
              <strong>{social.label}</strong>
              <small>{social.handle}</small>
            </span>
            <Icon name="arrow-up-right" size={15} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="brief">
    <div class="container brief__grid">
      <div class="brief__head" data-reveal>
        <span class="eyebrow">A useful first message</span>
        <h2>Four things<br />that help.</h2>
      </div>
      <ol class="brief__list" data-reveal style="--delay: 80ms">
        {brief.map((item, index) => (
          <li>
            <span class="mono">0{index + 1}</span>
            <p>{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="faq">
    <div class="container faq__grid">
      <div class="faq__head" data-reveal>
        <span class="eyebrow">Before you ask</span>
        <h2>Questions,<br /><em>answered.</em></h2>
        <p class="mono">Still unsure? Ask in the DM.</p>
      </div>
      <div class="faq__list" data-reveal style="--delay: 80ms">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    background:
      radial-gradient(ellipse at 78% 34%, rgba(201, 255, 87, 0.075), transparent 34%),
      var(--ink);
  }

  .contact-hero h1 {
    font-size: clamp(4rem, 10.5vw, 12rem);
  }

  .contact-clock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.57rem;
  }

  .contact-main {
    padding-block: clamp(60px, 8vw, 110px);
    border-bottom: 1px solid var(--line);
  }

  .contact-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(48px, 9vw, 150px);
    align-items: start;
  }

  .contact-primary h2 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 6.4rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .contact-primary h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .contact-primary > p {
    max-width: 45ch;
    margin-top: 24px;
    color: var(--muted-strong);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .contact-primary__button {
    margin-top: 30px;
    gap: 10px;
  }

  .contact-primary__status {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 0.52rem;
  }

  .contact-channels {
    border-top: 1px solid var(--line);
  }

  .contact-channels__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-block: 13px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: 0.52rem;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 15px;
    padding-block: 15px;
    border-bottom: 1px solid var(--line-soft);
    transition: padding-left 0.3s, border-color 0.3s;
  }

  .channel__icon {
    display: grid;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted-strong);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
    place-items: center;
  }

  .channel__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .channel__body strong {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 540;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .channel__body small {
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .channel > :global(svg) {
    color: var(--muted);
    transition: color 0.25s, transform 0.25s;
  }

  .channel:hover {
    padding-left: 6px;
    border-color: var(--line);
  }

  .channel:hover .channel__icon {
    border-color: var(--acid);
    background: var(--acid);
    color: var(--ink);
  }

  .channel:hover > :global(svg) {
    color: var(--acid);
    transform: translate(2px, -2px);
  }

  .brief {
    padding-block: clamp(64px, 8vw, 110px);
  }

  .brief__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 8vw, 120px);
  }

  .brief__head h2 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .brief__list {
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .brief__list li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 18px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  .brief__list li span {
    padding-top: 3px;
    color: var(--acid);
    font-size: 0.54rem;
  }

  .brief__list li p {
    max-width: 42ch;
    color: var(--paper-dim);
    font-size: 1rem;
    line-height: 1.5;
  }

  .faq {
    padding-block: clamp(64px, 8vw, 110px);
    border-top: 1px solid var(--line);
    background: var(--ink-raised);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: start;
  }

  .faq__head h2 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .faq__head h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .faq__head > p {
    margin-top: 22px;
    color: var(--muted);
    font-size: 0.54rem;
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line-soft);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 18px;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    position: relative;
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 1px;
    background: var(--muted-strong);
    content: '';
    transform: translate(-50%, -50%);
    transition: transform 0.25s;
  }

  .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-item p {
    max-width: 58ch;
    padding: 0 36px 20px 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .contact-main__grid,
    .brief__grid,
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .brief__head h2,
    .faq__head h2 {
      max-width: 12ch;
    }
  }

  @media (max-width: 600px) {
    .page-hero__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
    .contact-channels__head span:last-child {
      display: none;
    }
    .brief__list li {
      grid-template-columns: 28px minmax(0, 1fr);
    }
  }
</style>

<script>
  const clock = document.querySelector<HTMLElement>('[data-contact-clock]');
  if (clock) {
    const update = () => {
      clock.textContent = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Asia/Jakarta',
      }).format(new Date());
    };
    update();
    window.setInterval(update, 30_000);
  }
</script>
