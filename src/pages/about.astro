---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import { asset, url } from '../lib/paths';
import { imagePlaceholder } from '../lib/images';

const beliefs = [
  {
    number: '01',
    title: 'The story is the technology',
    text: 'A new model is only interesting when it helps a feeling land. I start with the feeling.',
  },
  {
    number: '02',
    title: 'Taste cannot be automated',
    text: 'Generation is cheap. Choosing what deserves to exist is the work.',
  },
  {
    number: '03',
    title: 'Transparency is part of the craft',
    text: 'AI-assisted work should say so. The process is not a secret; it is part of the point.',
  },
];

const toolkit = [
  'Suno',
  'Kling',
  'n8n',
  'Ollama',
  'OpenClaw',
  'Node.js',
  'Apache',
  'Google Sheets',
  'Linux',
];
---

<BaseLayout
  title="About — Nanjar Budiman"
  description="Nanjar Budiman is an AI content creator, musician, and cinematic storyteller based in Bandung, Indonesia. The story behind the practice."
>
  <header class="page-hero about-hero">
    <div class="container">
      <div class="page-hero__top">
        <span class="eyebrow">About / The practice</span>
        <span class="mono">Bandung, ID · 6.9175° S</span>
      </div>

      <h1 aria-label="The human behind the prompt.">The human<br />behind the<br /><em>prompt.</em></h1>

      <div class="page-hero__bottom">
        <p class="page-hero__intro" data-reveal style="--delay: 80ms">
          I am Nanjar Budiman — an AI content creator, musician, and cinematic storyteller. I build
          songs, films, and systems from a small studio in Bandung.
        </p>
        <p class="page-hero__aside" data-reveal style="--delay: 140ms">
          AI music<br />
          Cinematic video<br />
          Creative automation<br />
          Human direction
        </p>
      </div>
    </div>
  </header>

  <section class="about-story">
    <div class="container about-story__grid">
      <div class="about-story__portrait" data-reveal>
        <img
          src={imagePlaceholder}
          data-src={asset('assets/images/nanjar-960.webp')}
          data-srcset={`${asset('assets/images/nanjar-480.webp')} 480w, ${asset('assets/images/nanjar-960.webp')} 960w`}
          sizes="(max-width: 900px) 100vw, 540px"
          alt="Portrait of Nanjar Budiman"
          width="960"
          height="960"
          loading="lazy"
          decoding="async"
        />
        <span class="mono">Portrait / natural light, no prompt</span>
      </div>

      <div class="about-story__copy">
        <p class="about-story__lead" data-reveal>
          I use AI to move faster.<br />
          I use <em>taste</em> to decide<br />
          what is worth making.
        </p>

        <div data-reveal style="--delay: 80ms">
          <p>
            My path into this work did not start with a model. It started with stories — songs that made
            a feeling specific, films that could hold a silence. Generative tools arrived later, and they
            gave me a way to make the images and sounds I could previously only describe.
          </p>
          <p>
            Today I work across three disciplines that keep feeding each other: music, moving images, and
            automation. A song needs a visual world. A film needs a rhythm. A studio needs systems so the
            creative work has room to breathe.
          </p>
          <p>
            I am less interested in AI as a spectacle than as a craft material. The interesting question
            is not “can it make this?” but “is this worth watching, hearing, or keeping?”
          </p>
        </div>

        <div class="about-story__signature" data-reveal style="--delay: 130ms">
          <span>Nanjar Budiman</span>
          <small class="mono">Founder / one-person studio</small>
        </div>
      </div>
    </div>
  </section>

  <section class="beliefs">
    <div class="container">
      <div class="beliefs__head">
        <span class="eyebrow">Working principles</span>
        <h2>What I keep<br /><em>coming back to.</em></h2>
      </div>
      <div class="beliefs__grid">
        {beliefs.map((belief, index) => (
          <article class="belief" data-reveal style={`--delay:${index * 70}ms`}>
            <span class="mono">{belief.number}</span>
            <h3>{belief.title}</h3>
            <p>{belief.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="studio">
    <div class="container studio__grid">
      <div class="studio__image" data-reveal>
        <img
          src={imagePlaceholder}
          data-src={asset('assets/images/studio-400.webp')}
          alt="Nanjar's studio desk with monitoring displays"
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
        />
        <span class="studio__corner mono">The control room</span>
      </div>

      <div class="studio__copy">
        <span class="eyebrow" data-reveal>The setup</span>
        <h2 data-reveal>A small room<br />with a long <em>reach.</em></h2>
        <p data-reveal>
          A workstation, a local server, a handful of models, and a bias toward finishing things. The
          toolkit changes often; the standard does not.
        </p>
        <div class="toolkit" data-reveal>
          {toolkit.map((tool) => <span class="tag">{tool}</span>)}
        </div>
        <div class="studio__links" data-reveal>
          <a class="link-arrow" href={url('/work/')}>See the work <Icon name="arrow-right" size={14} /></a>
          <a class="link-arrow" href={url('/blog/')}>Read the notes <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .about-hero h1 {
    font-size: clamp(4rem, 10.5vw, 12rem);
  }

  .about-story {
    padding-block: clamp(60px, 8vw, 110px);
    border-bottom: 1px solid var(--line);
  }

  .about-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(44px, 8vw, 130px);
    align-items: start;
  }

  .about-story__portrait {
    position: relative;
    max-width: 540px;
  }

  .about-story__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    object-fit: cover;
    object-position: 50% 25%;
    filter: contrast(1.04) saturate(0.75);
  }

  .about-story__portrait span {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.5rem;
  }

  .about-story__lead {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .about-story__lead em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .about-story__copy > div:not(.about-story__signature) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 38px;
  }

  .about-story__copy p {
    color: var(--muted-strong);
    font-size: 0.86rem;
    line-height: 1.72;
  }

  .about-story__signature {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 38px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .about-story__signature span {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-style: italic;
    line-height: 1;
  }

  .about-story__signature small {
    color: var(--muted);
    font-size: 0.5rem;
  }

  .beliefs {
    padding-block: clamp(66px, 8vw, 110px);
  }

  .beliefs__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }

  .beliefs__head h2 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.4vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .beliefs__head h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .beliefs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-left: 1px solid var(--line);
    margin-top: 32px;
  }

  .belief {
    min-height: 260px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .belief > span {
    color: var(--acid);
    font-size: 0.54rem;
  }

  .belief h3 {
    margin-top: 52px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.9vw, 1.6rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .belief p {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .studio {
    padding-block: clamp(64px, 8vw, 110px);
    border-top: 1px solid var(--line);
    background: var(--ink-raised);
  }

  .studio__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
  }

  .studio__image {
    position: relative;
    max-width: 440px;
  }

  .studio__image img {
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    object-fit: cover;
    filter: saturate(0.65) brightness(0.85);
  }

  .studio__corner {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 6px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(8, 10, 11, 0.7);
    color: var(--muted-strong);
    font-size: 0.48rem;
    backdrop-filter: blur(6px);
  }

  .studio h2 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .studio h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .studio__copy > p {
    max-width: 46ch;
    margin-top: 22px;
    color: var(--muted-strong);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .toolkit {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 26px;
  }

  .studio__links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 32px;
  }

  @media (max-width: 900px) {
    .about-story__grid,
    .studio__grid {
      grid-template-columns: 1fr;
    }
    .about-story__portrait {
      width: min(100%, 500px);
    }
    .beliefs__grid {
      grid-template-columns: 1fr;
    }
    .belief {
      min-height: 0;
    }
    .belief h3 {
      margin-top: 24px;
    }
  }

  @media (max-width: 600px) {
    .about-story__copy > div:not(.about-story__signature) {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .about-story__signature {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
    .beliefs__head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
