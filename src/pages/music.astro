---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumArt from '../components/AlbumArt.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Icon from '../components/Icon.astro';
import { tracks } from '../data/site';
import { url } from '../lib/paths';

const featured = tracks[0];
const steps = [
  { number: '01', title: 'Find the feeling', text: 'A phrase, a memory, a scene. The song starts as a sentence I cannot stop thinking about.' },
  { number: '02', title: 'Write it down', text: 'Lyrics first. Structure, point of view, the line that carries the whole thing.' },
  { number: '03', title: 'Generate, then direct', text: 'Suno gives me dozens of possibilities. I keep the take with the right ache, then edit.' },
  { number: '04', title: 'Finish it properly', text: 'Mix, master, artwork, distribution. A demo is not a release.' },
];
---

<BaseLayout
  title="Music — Nanjar Budiman"
  description="AI-assisted songs by Nanjar Budiman: emotional Indonesian pop, cinematic ballads, and quiet experiments. Listen on Spotify."
>
  <header class="page-hero music-hero">
    <div class="container">
      <div class="page-hero__top">
        <span class="eyebrow">Discography / 2026</span>
        <span class="mono">06 releases · Spotify</span>
      </div>

      <h1 aria-label="Songs for the in-between.">Songs for the<br /><em>in-between.</em></h1>

      <div class="page-hero__bottom">
        <p class="page-hero__intro" data-reveal style="--delay: 80ms">
          Love, distance, faith, and the things we only say when the room is empty. Written and produced
          with AI as a collaborator — sung in Indonesian, felt in any language.
        </p>
        <p class="page-hero__aside" data-reveal style="--delay: 140ms">
          Written in Bandung<br />
          Released worldwide<br />
          Written &amp; directed by Nanjar
        </p>
      </div>
    </div>
  </header>

  <section class="featured-release">
    <div class="container featured-release__grid">
      <div class="featured-release__art" data-reveal>
        <AlbumArt track={featured} index={0} />
      </div>

      <div class="featured-release__copy" data-reveal style="--delay: 100ms">
        <span class="eyebrow">Latest single</span>
        <h2>Biarkan Aku<br /><em>Pulang Lebih Dulu.</em></h2>
        <p>
          A song about leaving before you are left. Slow, warm, and a little unresolved — the way most
          goodbyes actually feel.
        </p>
        <div class="featured-release__actions">
          <a
            class="btn btn--acid"
            href={`https://open.spotify.com/album/${featured.spotifyId}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="spotify" size={17} />
            Listen on Spotify
          </a>
          <span class="mono">Single / 2026</span>
        </div>
        <div class="featured-release__note">
          <span class="mono">Official release</span>
          <span>Written in Bandung · distributed worldwide</span>
        </div>
      </div>
    </div>
  </section>

  <section class="discography">
    <div class="container">
      <div class="discography__head">
        <div>
          <span class="eyebrow">All releases</span>
          <h2>Six ways to<br /><em>disappear for a while.</em></h2>
        </div>
        <p class="mono">Stream on Spotify / all platforms</p>
      </div>

      <div class="release-grid">
        {tracks.map((track, index) => (
          <a
            class="release-card"
            href={`https://open.spotify.com/album/${track.spotifyId}`}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
            style={`--delay:${(index % 3) * 70}ms`}
          >
            <span class="release-card__art"><AlbumArt track={track} index={index} /></span>
            <span class="release-card__meta mono">
              <span>{String(index + 1).padStart(2, '0')} / Single</span>
              <Icon name="spotify" size={14} />
            </span>
            <span class="release-card__title">{track.title}</span>
            <span class="release-card__foot">
              <span>Nanjar Budiman</span>
              <Icon name="arrow-up-right" size={14} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="score-section">
    <div class="container score-section__grid">
      <div class="score-section__copy">
        <span class="eyebrow">Off-platform</span>
        <h2>AI Maverick.<br /><em>An original score.</em></h2>
        <p>
          A piece written for motion rather than streaming. No algorithm, no release plan — just a
          texture looking for a scene.
        </p>
      </div>
      <div class="score-section__player">
        <AudioPlayer title="AI Maverick" subtitle="Original score — unreleased" />
      </div>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <div class="process__head">
        <span class="eyebrow">Process</span>
        <h2>From a line<br />to a <em>release.</em></h2>
      </div>
      <div class="process__grid">
        {steps.map((step, index) => (
          <article class="process-step" data-reveal style={`--delay:${index * 60}ms`}>
            <span class="process-step__number mono">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
      <a class="process__link link-arrow" href={url('/blog/cara-membuat-lagu-ai-suno-spotify/')}>
        Read the full songwriting workflow
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </section>

  <section class="music-cta">
    <div class="container">
      <p class="eyebrow">Need a song?</p>
      <h2>Let's write<br /><em>yours.</em></h2>
      <a class="btn btn--outline" href={url('/contact/')}>
        Start a conversation
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .music-hero {
    background:
      radial-gradient(ellipse at 82% 25%, rgba(255, 107, 61, 0.07), transparent 30%),
      var(--ink);
  }

  .music-hero h1 {
    font-size: clamp(4.2rem, 10.5vw, 12rem);
  }

  .featured-release {
    padding-block: clamp(54px, 7vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .featured-release__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(44px, 8vw, 130px);
    align-items: center;
  }

  .featured-release__art {
    max-width: 560px;
  }

  .featured-release__copy h2 {
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.8vw, 6.2rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .featured-release__copy h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .featured-release__copy > p {
    max-width: 46ch;
    margin-top: 24px;
    color: var(--muted-strong);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .featured-release__actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 28px;
  }

  .featured-release__actions .mono {
    color: var(--muted);
    font-size: 0.54rem;
  }

  .featured-release__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    max-width: 560px;
    margin-top: 34px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .featured-release__note .mono {
    color: var(--acid);
    font-size: 0.5rem;
  }

  .discography {
    padding-block: clamp(72px, 9vw, 130px);
  }

  .discography__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }

  .discography__head h2 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.2vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .discography__head h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .discography__head > p {
    padding-bottom: 6px;
    color: var(--muted);
    font-size: 0.53rem;
    white-space: nowrap;
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(34px, 4vw, 56px) clamp(18px, 2.5vw, 34px);
    margin-top: 42px;
  }

  .release-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .release-card__art {
    display: block;
    transition: transform 0.7s var(--ease), filter 0.4s;
  }

  .release-card:hover .release-card__art {
    transform: translateY(-5px) rotate(-0.7deg);
    filter: brightness(1.08);
  }

  .release-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.52rem;
  }

  .release-card__title {
    margin-top: 7px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.08;
    transition: color 0.25s;
  }

  .release-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .release-card:hover .release-card__title,
  .release-card:hover .release-card__foot {
    color: var(--acid);
  }

  .score-section {
    padding-block: clamp(64px, 8vw, 110px);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse at 30% 50%, rgba(201, 255, 87, 0.045), transparent 35%),
      var(--ink-raised);
  }

  .score-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
  }

  .score-section h2 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .score-section h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .score-section__copy p {
    max-width: 42ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .process {
    padding-block: clamp(72px, 9vw, 130px);
    border-top: 1px solid var(--line);
  }

  .process__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .process__head h2 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.6vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }

  .process__head h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-left: 1px solid var(--line);
    margin-top: 34px;
  }

  .process-step {
    min-height: 240px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .process-step__number {
    color: var(--acid);
    font-size: 0.55rem;
  }

  .process-step h3 {
    margin-top: 42px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .process-step p {
    margin-top: 9px;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .process__link {
    margin-top: 28px;
  }

  .music-cta {
    padding-block: clamp(64px, 8vw, 110px);
    border-top: 1px solid var(--line);
  }

  .music-cta h2 {
    margin: 18px 0 30px;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.84;
  }

  .music-cta h2 em {
    color: var(--acid);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .featured-release__grid,
    .score-section__grid {
      grid-template-columns: 1fr;
    }
    .featured-release__art {
      width: min(100%, 520px);
    }
    .release-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .process__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .discography__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
    .release-grid {
      grid-template-columns: 1fr;
    }
    .process__grid {
      grid-template-columns: 1fr;
    }
    .process-step {
      min-height: 0;
    }
    .process-step h3 {
      margin-top: 24px;
    }
  }
</style>
